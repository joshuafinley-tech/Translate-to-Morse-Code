from asyncio import Handle # VS Code seems to feakout if I take this line out, but it doesn't seem to do anything
import winsound
import time

frequency = 800 # Set Frequency To 800 Hertz

unit = 240 # Set Duration To 240 ms == 0.24 second
# the pause timing only seems to work correctly when the units are higher so I could not operate the program on 120 ms or 60 ms

#defalt volume level
volume = 50

# These two lists give the characters an index that the program uses to convert the text to morse code.
characters = (" ", "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0")
conversion = (" ", ".-", "-...", "-.-.", "-..", ".", "..-.", "--.", "....", "..", ".---", "-.-", ".-..", "--", "-.", "---", ".--.", "--.-", ".-.", "...", "-", "..-", "...-", ".--", "-..-", "-.--", "--..", ".----", "..---", "...--", "....-", ".....", "-....", "--...", "---..", "----.", "-----")

# this function converts characters to code
def translate(text):

    # clears the stored code from previous input
    morse_code = "" 

    # for each character it does this
    for char in text: 
        
        # lowers and checks if the character is in the list
        if char.lower() in characters: 
            index = characters.index(char.lower()) # finds the index in the characters list
            morse_code += conversion[index] + " " # adds the code based on each index given
        else:
            morse_code += "? "  # For characters not in the conversion list
    return morse_code

# a function that holds changable parameters influenced by commands is a funtion's list
def handle_command(text, volume): # text sets the true or false of should continue and volume holds the numeric volume level
    
    # returns false for should_continute if /exit or /quit or /stop is entered
    if text.lower() == "/exit" or text.lower() == "/quit" or text.lower() == "/stop": 
        return False, volume
    elif text.startswith("/volume "): # I think this needs to be fixed, but it is supposed to be able to change the volume
        try:
            volume = int(text.split("/volume ")[1])
            print(f"Volume set to {volume}")
        except (ValueError, IndexError): #error handling for invalid volume input
            print("Invalid volume. Usage: /volume <number>")
        return True, volume
    return True, volume # returns true for should_continue and volume level

# audio playing function
def play_morse_code(morse_code, volume):
    print("Playing morse code... (commands will be available after playback)")
    
    # this is supposed to give an index to each word and seperate them with spaces
    words = morse_code.strip().split('  ')
    for word_index, word in enumerate(words):
        
        # this is supposed to give an index to each letter within each word and seperate them with spaces
        letters = word.split(' ')
        for letter_index, letter in enumerate(letters):
           
            # this gives an index for each code symbol within each letter and plays the sound outloud
            for symbol_index, char in enumerate(letter):
                if char == ".":
                    winsound.Beep(frequency, unit) # - dot = 1 unit
                elif char == "-":
                    winsound.Beep(frequency, unit * 3) # - dash = 3 units
                else:
                    print("Unknown symbol:", char) # to handle unknown characters
                    continue

                # this basically checks if it has read the last symbol if it has then it will skip this pause type
                if symbol_index < len(letter) - 1:
                    time.sleep(unit / 1000) # - pause between symbols in a letter = 1 unit

            # check if at the last letter in the word, if not then it will do the pause between letters
            if letter_index < len(letters) - 1:
                time.sleep(unit * 3 / 1000) # - pause between letters = 3 units

        #check if there are still more words to read and if True then will pause between words
        if word_index < len(words) - 1:
            time.sleep(unit * 7 / 1000) # - pause between words = 7 units

    return True  # Continue main loop



#MAIN LOOP
while True:
    text = input("Enter text to convert to Morse code (or use / commands like '/volume #' or '/exit'): ")
    
    # Check for / commands first
    if text.startswith("/"):
        should_continue, volume = handle_command(text, volume) # ties should_continue to text and volume to volume
        if not should_continue:
            break
        continue
    
    # translates regular text to morse code
    morse_code = translate(text)
    
    # prints translation
    print("Morse code:", morse_code.strip()) 
    
    # plays the code out loud at the set volume
    should_continue = play_morse_code(morse_code, volume) 
    
    if not should_continue:
        break

    # then loops and shows menu again